# Figma personal access token (PAT).
# Create one in Figma: Settings → Security → Personal access tokens.
#
# Recommended scopes (add only what you need):
#   current_user:read
#   file_content:read          # files, nodes, rendered images, image fills
#   file_metadata:read
#   file_versions:read
#   file_comments:read
#   file_comments:write
#   projects:read
#   library_content:read
#   team_library_content:read
#   library_assets:read
#   file_variables:read        # variables (Enterprise)
#   file_dev_resources:read
#   file_dev_resources:write
#   webhooks:read
#   webhooks:write
FIGMA_ACCESS_TOKEN=figd_your_personal_access_token_here

# Optional. Numeric id after /team/ in a Figma team URL.
# FIGMA_TEAM_ID=1234567890

# Optional Desktop canvas write (off by default — core MCP is REST-only).
# Uncomment BOTH, then `npm run start:write`.
# FIGMA_ENABLE_WRITE_BRIDGE=1
# FIGMA_BRIDGE_TOKEN=change-me-to-a-long-random-string
# FIGMA_BRIDGE_PORT=3845
